{
  "manifest_version": 3,
  "name": "DP | X Source Label",
  "version": "0.1.0",
  "description": "X'in tweet verisinde hâlâ duran 'source' alanını (Twitter for iPhone, Twitter Web Client vb.) tweet zaman damgasının yanında gösterir.",
  "author": "bilgehnbilge",
  "browser_specific_settings": {
    "gecko": {
      "id": "x-kaynak-etiketi@bilgehnbilge",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "DP | X Source Label",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_start"
    }
  ]
}
